# =============================================================================
# Zorvia — Frontend (Next.js)
# Copy to frontend/.env — restart `npm run dev` after changes
# =============================================================================

# Browser-facing API is same-origin `/api` (Next rewrite). Backend target:
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Firebase client (Google Sign-In) — same project as backend service account — project mealhq-app (Google Sign-In)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=mealhq-app.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=mealhq-app
NEXT_PUBLIC_FIREBASE_APP_ID=
